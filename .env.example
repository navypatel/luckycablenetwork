# Private MongoDB Atlas URI with a least-privilege database user; never commit real values.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/lucky_cable?retryWrites=true&w=majority
MONGODB_DB=lucky_cable
# Generate a random 32+ character secret; required for sessions.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Canonical deployed origin used to validate browser mutations.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# 32+ random characters. Vercel Cron sends it as Authorization: Bearer <secret>.
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# One-time local bootstrap only: set when invoking npm run admin:bootstrap, then unset.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=