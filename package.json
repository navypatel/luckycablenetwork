{
  "name": "lucky-cable",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:ui": "playwright test --ui",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "bcryptjs": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.68.0",
    "mongoose": "^9.12.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "exceljs": "^4.4.0",
    "mongodb-memory-server": "^10.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.2.3": true
  }
}
